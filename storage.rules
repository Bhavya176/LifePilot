rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User file isolation: users/{userId}/{allPaths=**}
    match /users/{userId}/{allPaths=**} {
      // User can only read, write, upload, and delete their own files
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
