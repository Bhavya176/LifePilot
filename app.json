{
  "expo": {
    "name": "LifePilot",
    "slug": "LifePilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lifepilot",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.bhavya.LifePilot",
      "supportsTablet": false,
      "jsEngine": "hermes",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bhavya.LifePilot",
      "adaptiveIcon": {
        "backgroundColor": "#131127",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "jsEngine": "hermes"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1145114b-2edc-4938-9757-8f5fa7ebe03b"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-updates",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1145114b-2edc-4938-9757-8f5fa7ebe03b"
      }
    },
    "owner": "bhavya17"
  }
}
